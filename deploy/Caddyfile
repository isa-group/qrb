# TLS front for the QRB stack (docker compose --profile proxy). Terminates HTTPS
# with the certificate you bring (no ACME), redirects HTTP to HTTPS, and proxies
# everything to the gateway, which serves the website at / and the API at /api.
#
# Environment (set by docker-compose.yml from .env):
#   QRB_DOMAIN     public host name, e.g. qbinder.score.us.es
#   QRB_CERT_FILE  certificate (full chain) inside /certs
#   QRB_KEY_FILE   private key inside /certs
#   GRAFANA_INTERNAL_PORT  port for Grafana (profile monitoring), opened to the internal network only
{
	# Our own certificate: no ACME, but keep the automatic HTTP -> HTTPS redirect.
	auto_https disable_certs
	admin off
}

# Plain HTTP: always to the main HTTPS site on the default port. Without this explicit site,
# Caddy's automatic redirect can pick the Grafana port, since both sites share the host.
http://{$QRB_DOMAIN} {
	redir https://{host}{uri} 308
}

{$QRB_DOMAIN} {
	tls /certs/{$QRB_CERT_FILE} /certs/{$QRB_KEY_FILE}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Caddy sets X-Forwarded-For to the real client address (it trusts no upstream
	# proxy), and the gateway trusts it from this container's fixed address.
	reverse_proxy gateway:{$QRB_GATEWAY_PORT:3001} {
		# A bind on fresh provider data waits tens of seconds on IBM and Braket.
		transport http {
			read_timeout 300s
		}
	}
}

# Grafana (docker compose --profile monitoring) on its own port, same host and certificate.
# Open this port to the university's internal network only (firewall); Grafana has its own
# login on top. A separate port keeps Grafana a separate origin from the site and its admin API.
{$QRB_DOMAIN}:{$GRAFANA_INTERNAL_PORT:3443} {
	tls /certs/{$QRB_CERT_FILE} /certs/{$QRB_KEY_FILE}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy grafana:3000
}
