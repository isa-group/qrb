# Production settings for the VPS. Copy to the repo root as .env and fill in.
# Generate each secret with: openssl rand -hex 32   (POSTGRES_PASSWORD: openssl rand -hex 24)

# ---- Public site ----
QRB_DOMAIN=qbinder.score.us.es
BETTER_AUTH_URL=https://qbinder.score.us.es
NEXT_PUBLIC_SITE_URL=https://qbinder.score.us.es

# ---- Ports on the VM ----
# The university perimeter forwards public 80/443 to the VM's 8080/8443 (80 and 443 are closed
# on the VM's internal firewall). Visitors still use https://<QRB_DOMAIN> on 443.
QRB_HTTP_PORT=8080
QRB_HTTPS_PORT=8443

# ---- Your certificate (mounted read-only into the proxy at /certs) ----
QRB_CERT_DIR=/home/operador
QRB_CERT_FILE=fullchain.pem
QRB_KEY_FILE=privkey.pem

# ---- Secrets ----
QRB_GATEWAY_SECRET=
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=

# ---- Sign-in (the gateway does not start in production without them) ----
# GitHub OAuth app callback:  https://qbinder.score.us.es/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ORCID client redirect URI:  https://qbinder.score.us.es/api/auth/callback/orcid
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_ISSUER=https://orcid.org

# ---- Admin page (/admin) ----
# Your Better Auth user id (comma-separated for several). Sign in once, then find it with:
#   docker compose exec postgres psql -U qrb -d qrb -c 'SELECT id, name, email FROM "user"'
# Further admins can be promoted from the admin page.
QRB_ADMIN_USER_IDS=

# ---- Provider data (read-only; QRB never submits jobs) ----
QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=
QISKIT_IBM_INSTANCES=
QISKIT_IBM_CHANNEL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Limits: start in log mode to watch real traffic, then switch to enforce ----
QRB_LIMITS_MODE=log

# ---- Monitoring (docker compose --profile monitoring; see deploy/README.md) ----
# Grafana is served by the proxy on this port: open it to the internal network only.
GRAFANA_INTERNAL_PORT=3443
GRAFANA_ADMIN_PASSWORD=
# Read-only Postgres role for Grafana, and the postgres-exporter role (statistics only).
GRAFANA_DB_PASSWORD=
QRB_EXPORTER_PASSWORD=
# Defaults to https://<QRB_DOMAIN>:<GRAFANA_INTERNAL_PORT>.
GRAFANA_ROOT_URL=
