# Production settings for the VPS. Copy to the repo root as .env and fill in.
# Generate each secret with: openssl rand -hex 32   (POSTGRES_PASSWORD: openssl rand -hex 24)

# ---- Public site ----
QRB_DOMAIN=qbinder.score.es
BETTER_AUTH_URL=https://qbinder.score.es
NEXT_PUBLIC_SITE_URL=https://qbinder.score.es

# ---- Your certificate (mounted read-only into the proxy at /certs) ----
QRB_CERT_DIR=/home/operador
QRB_CERT_FILE=fullchain.pem
QRB_KEY_FILE=privkey.pem

# ---- Secrets ----
QRB_GATEWAY_SECRET=
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=

# ---- Sign-in (the gateway does not start in production without them) ----
# GitHub OAuth app callback:  https://qbinder.score.es/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ORCID client redirect URI:  https://qbinder.score.es/api/auth/callback/orcid
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_ISSUER=https://orcid.org

# ---- Provider data (read-only; QRB never submits jobs) ----
QISKIT_IBM_TOKEN=
QISKIT_IBM_INSTANCE=
QISKIT_IBM_INSTANCES=
QISKIT_IBM_CHANNEL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---- Limits: start in log mode to watch real traffic, then switch to enforce ----
QRB_LIMITS_MODE=log
