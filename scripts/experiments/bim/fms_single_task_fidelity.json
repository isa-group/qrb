{
  "metadata": {
    "id": "fms_single_task_fidelity",
    "name": "FMS Motivating Scenario - Fidelity-driven",
    "version": "3.0.0",
    "created_at": "2026-09-27T00:00:00Z",
    "description": "Motivating scenario of the paper (Sections 3-4): one 15-qubit QAOA routing circuit, 1024 shots, bound over the illustrative catalog of Table 1. Fidelity-driven profile. Expected binding: Quantinuum H2 via Azure (95%, 9.80 EUR)."
  },
  "features": [
    {
      "id": "fidelity",
      "name": "Expected Fidelity",
      "direction": "MAXIMIZE",
      "unit": "probability",
      "scale": "RATIO",
      "valid_range": {
        "min": 0,
        "max": 1
      },
      "description": "Expected execution fidelity of the sub-circuit on the offering."
    },
    {
      "id": "cost",
      "name": "Cost",
      "direction": "MINIMIZE",
      "unit": "EUR",
      "scale": "RATIO",
      "valid_range": {
        "min": 0,
        "max": 1000
      },
      "description": "Execution cost of the sub-circuit (1024 shots) on the offering."
    },
    {
      "id": "queue",
      "name": "Queue Length",
      "direction": "MINIMIZE",
      "unit": "pending_jobs",
      "scale": "RATIO",
      "valid_range": {
        "min": 0,
        "max": 10000
      },
      "description": "Pending jobs in the offering's queue at request time."
    },
    {
      "id": "num_qubits",
      "name": "Qubit Count",
      "direction": "MAXIMIZE",
      "unit": "count",
      "scale": "RATIO",
      "valid_range": {
        "min": 0,
        "max": 10000
      },
      "description": "Device capacity; anchors the local capacity constraint."
    },
    {
      "id": "operational",
      "name": "Operational",
      "direction": "MAXIMIZE",
      "unit": "boolean",
      "scale": "RATIO",
      "valid_range": {
        "min": 0,
        "max": 1
      },
      "description": "1 if the provider currently grants access to the resource (Table 1 status 'available'), 0 under maintenance or offline."
    },
    {
      "id": "real_device",
      "name": "Real Device",
      "direction": "MAXIMIZE",
      "unit": "boolean",
      "scale": "RATIO",
      "valid_range": {
        "min": 0,
        "max": 1
      },
      "description": "1 for physical QPUs, 0 for simulators; anchors the user's real-device requirement."
    }
  ],
