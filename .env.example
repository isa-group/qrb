# Copy to .env and fill in. Never committed (see .gitignore).
# Read-only credentials: qrb fetches provider metadata, never submits jobs (ADR 0002).

# IBM Quantum (qiskit-ibm-runtime)
QISKIT_IBM_TOKEN=
# Single instance (IBM Cloud CRN) — used if QISKIT_IBM_INSTANCES is unset.
QISKIT_IBM_INSTANCE=
# Multiple instances/"zones" — comma-separated CRNs, unions their backends
# into one catalog (dedup'd by device name; see qrb/providers/ibm.py).
# Takes priority over QISKIT_IBM_INSTANCE above when set.
QISKIT_IBM_INSTANCES=
QISKIT_IBM_CHANNEL=

# Amazon Braket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# apps/web (Next.js) — see apps/web/lib/api/client.ts, lib/query-config.ts
# The gateway serves the web build and the API from one origin, API under /api,
# so the default (/api) needs no setting. For local dev with the web dev server
# (:3000) and the gateway on another port, set e.g. http://localhost:3001/api.
# NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_CATALOG_POLL_INTERVAL_MS=600000
# Mock catalog data (see lib/api/mock-catalog.ts) — on by default since real
# IBM/Braket credentials usually aren't available. Set to "false" once
# apps/api has live credentials configured.
NEXT_PUBLIC_USE_MOCK_CATALOG=true

# apps/gateway — process settings (docker-compose.yml sets sensible values;
# these matter when running the gateway directly, e.g. `task gateway:dev`).
# NODE_ENV=production makes the gateway refuse to start without the auth,
# Turnstile and DATABASE_URL settings below. Leave it unset for local dev.
# NODE_ENV=production
# Listen port. In compose it is also the loopback-only host port the VPS
# reverse proxy forwards to (127.0.0.1:PORT).
# PORT=3001
# Listen address. Default 127.0.0.1; compose sets 0.0.0.0 INSIDE the
# container (the host publish stays on 127.0.0.1).
# HOST=127.0.0.1
# Directory of the web static export served at `/`. Default apps/web/out;
# the gateway image sets /app/web.
# WEB_ROOT=
# Where the gateway reaches the Python API. Compose sets http://api:8000;
# default http://127.0.0.1:8000.
# QRB_API_URL=http://127.0.0.1:8000

# apps/api — shared secret the gateway sends as X-QRB-Gateway-Secret. Every
# API route except /health requires it. Use a long random value, e.g.
# `openssl rand -hex 32`, and set the same value for apps/gateway. If unset,
# the API rejects every request but /health with 401 (fails closed).
QRB_GATEWAY_SECRET=
# apps/api — local development only: set to 1 to let the API run without
# QRB_GATEWAY_SECRET and to enable WEB_ORIGINS CORS so apps/web can call it
# directly. Never set in production. Ignored when QRB_GATEWAY_SECRET is set
# (the secret is then always required), but CORS is still enabled.
QRB_ALLOW_UNAUTHENTICATED=
# apps/api — comma-separated origins allowed to call the API from a browser.
# Only used when QRB_ALLOW_UNAUTHENTICATED=1; in production only the gateway
# calls the API, so there is no CORS.
# apps/gateway — in development (NODE_ENV != production) these origins are
# also trusted by the auth routes (sign-in callback URLs, origin checks).
# Ignored by the gateway in production, where web and API share one origin.
WEB_ORIGINS=http://localhost:3000,http://localhost:3002

# apps/gateway — Better Auth (sign-in with GitHub or ORCID; no email/password).
# Public origin of the gateway; auth routes live under <BETTER_AUTH_URL>/api/auth.
# Required in production and must be https (session cookies are then Secure).
# Defaults to http://localhost:3001 in development.
BETTER_AUTH_URL=
# Signs session cookies and OAuth state. Required in production (at least 32
# characters), e.g. `openssl rand -hex 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# GitHub OAuth app (https://github.com/settings/developers). Callback URL:
# <BETTER_AUTH_URL>/api/auth/callback/github. Required in production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ORCID public API client (https://orcid.org/developer-tools). Redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/orcid. Required in production.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# https://orcid.org (production) or https://sandbox.orcid.org (testing).
# Defaults to the sandbox in development and to orcid.org in production.
ORCID_ISSUER=
# Comma-separated proxy addresses/CIDRs. Docker compose: the host reverse proxy
# reaches the published port from the compose network's gateway address, not
# 127.0.0.1. Compose pins the network to QRB_NETWORK_SUBNET (default
# 172.28.0.0/24) and defaults this to 127.0.0.1,::1,172.28.0.1; if you change
# the subnet, change this too (docs/deploy-vps.md section 2.2). X-Forwarded-For is read only when the
# connection comes from one of them (right-most entry that is not itself a
# trusted proxy wins); otherwise the socket address is the client IP. Used by
# the per-IP anonymous cap, the per-IP open-route limit and the auth-route
# limiter. Default: 127.0.0.1,::1 (the local reverse proxy).
TRUSTED_PROXIES=
# apps/gateway — Cloudflare Turnstile (CAPTCHA on anonymous resolves; signed-in
# users and API keys skip it). Secret key from the Cloudflare dashboard.
# Required in production (the gateway refuses to start without it). In
# development, unset uses Cloudflare's test secret that accepts any token.
TURNSTILE_SECRET_KEY=
# Optional: also require the siteverify answer's hostname / action to match
# (the domain the widget runs on, e.g. qrb.example.org; the widget's action).
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=
# apps/web — Turnstile site key (public), build-time. For development use
# Cloudflare's test key 1x00000000000000000000AA (always passes).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# apps/gateway — quotas and rate limits (all optional; defaults shown).
# Roll out in log-only mode first: with QRB_LIMITS_MODE=log, a request that
# would get 429 (user daily quota, per-IP anonymous cap, identity/key burst,
# open-route per-IP limit) is let through and logged as one JSON line
# {"event":"limit_would_reject","limit":...,"key":...,"status":429}; counters
# still increase. Policy rejections (401, 403 CAPTCHA / live refresh, 422) are
# always enforced. Switch to enforce (the default) once the logs look right.
QRB_LIMITS_MODE=enforce
# Daily resolve units per user (reset 00:00 UTC) and what a live refresh costs.
QRB_LIMIT_ANON_DAILY=10
QRB_LIMIT_SIGNED_IN_DAILY=200
QRB_LIMIT_LIVE_REFRESH_WEIGHT=5
# Daily units shared by all anonymous users at one IP.
QRB_LIMIT_ANON_IP_DAILY=30
# Burst limits (requests per window): per anonymous / signed-in identity, per API key.
QRB_LIMIT_BURST_WINDOW_SECONDS=60
QRB_LIMIT_BURST_ANON=3
QRB_LIMIT_BURST_SIGNED_IN=20
QRB_LIMIT_BURST_API_KEY=20
# Open routes (health, catalog, engines, presets): requests per window per IP.
QRB_LIMIT_OPEN_WINDOW_SECONDS=60
QRB_LIMIT_OPEN_PER_IP=60
# apps/gateway — without DATABASE_URL (development only) the gateway uses
# PGlite, an in-process Postgres. Set a directory to keep its data between
# runs; unset means in memory (accounts are lost on restart).
PGLITE_DATA_DIR=

# Historical data (packages/qrb-store, apps/poller) — optional. Unset
# means qrb_store.record_binding()/record_telemetry_sample() are no-ops;
# selection itself works with zero Postgres configured either way.
DATABASE_URL=postgresql+psycopg://qrb:qrb@localhost:5432/qrb
# `postgres` docker-compose service (private network, data in the `pgdata`
# volume). Compose builds DATABASE_URL for gateway/poller from this, so the
# DATABASE_URL above is only for running things on the host. Use a long
# random value in production, URL-safe characters only (e.g. `openssl rand -hex 24`).
# User and database are both `qrb`.
POSTGRES_PASSWORD=qrb
# Compose network subnet (pinned so TRUSTED_PROXIES can name its gateway).
# QRB_NETWORK_SUBNET=172.28.0.0/24
# How often apps/poller samples the live catalog into catalog_telemetry.
QRB_POLLER_INTERVAL_SECONDS=900

# apps/api — catalog snapshot read when a request sets live=false. Clients
# cannot choose a path (snapshot_path is rejected with 422). Unset means
# catalog_snapshot.json in the API's working directory.
QRB_SNAPSHOT_PATH=
