# Copy to .env and fill in. Never committed (see .gitignore).
# Read-only credentials: qrb fetches provider metadata, never submits jobs (ADR 0002).

# IBM Quantum (qiskit-ibm-runtime)
QISKIT_IBM_TOKEN=
# Single instance (IBM Cloud CRN) — used if QISKIT_IBM_INSTANCES is unset.
QISKIT_IBM_INSTANCE=
# Multiple instances/"zones" — comma-separated CRNs, unions their backends
# into one catalog (dedup'd by device name; see qrb/providers/ibm.py).
# Takes priority over QISKIT_IBM_INSTANCE above when set.
QISKIT_IBM_INSTANCES=
QISKIT_IBM_CHANNEL=

# Amazon Braket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# OpenBinding gateway (packages/openbinding). Unset or empty uses the public
# gateway https://openbinding.score.us.es/api. For a local gateway, e.g.
# OPENBINDING_URL=http://localhost:8001 after `task openbinding:up` (from
# inside docker-compose containers, use http://openbinding:8000 instead).
OPENBINDING_URL=
# Host port for the local gateway started by `task openbinding:up`.
OPENBINDING_PORT=8001

# apps/web (Next.js) — base URL of the QRB API the browser talks to; see
# apps/web/lib/api/client.ts. Next only loads env files from apps/web, so put
# this in apps/web/.env.local (template: apps/web/.env.example). Locally:
# http://localhost:8000 (the API directly, `task api:dev`) or
# http://localhost:3001/api (through the gateway, `task gateway:dev`). In the
# compose stack the site is served by the gateway and calls /api on its origin.
NEXT_PUBLIC_QRB_API=http://localhost:8000
# apps/gateway — process settings (docker-compose.yml sets sensible values;
# these matter when running the gateway directly, e.g. `task gateway:dev`).
# NODE_ENV=production makes the gateway refuse to start without the auth and
# DATABASE_URL settings below. Leave it unset for local dev.
# NODE_ENV=production
# Listen port. In compose it is also the loopback-only host port the reverse
# proxy forwards to (127.0.0.1:PORT).
# PORT=3001
# Listen address. Default 127.0.0.1; compose sets 0.0.0.0 INSIDE the container.
# HOST=127.0.0.1
# Where the gateway reaches the Python API. Compose sets http://api:8000.
# QRB_API_URL=http://127.0.0.1:8000
# The website's Next.js server, served at / (everything outside /api). Compose
# sets http://web:3000; unset serves the API only.
# WEB_UPSTREAM_URL=http://127.0.0.1:3000

# apps/api — shared secret the gateway sends as X-QRB-Gateway-Secret. Every
# API route except /health requires it. Use a long random value, e.g.
# `openssl rand -hex 32`, and set the same value for apps/gateway. If unset,
# the API rejects every request but /health with 401 (fails closed).
QRB_GATEWAY_SECRET=
# apps/api — local development only: set to 1 to let the API run without
# QRB_GATEWAY_SECRET and to enable WEB_ORIGINS CORS so apps/web can call it
# directly (`task api:dev` sets it). Never set in production. Ignored when
# QRB_GATEWAY_SECRET is set (the secret is then always required).
QRB_ALLOW_UNAUTHENTICATED=
# Comma-separated browser origins for local development: CORS on the API (with
# QRB_ALLOW_UNAUTHENTICATED=1) and on the gateway, and trusted by the auth
# routes. Ignored by the gateway in production, where site and API share one
# origin.
WEB_ORIGINS=http://localhost:3000,http://localhost:3002

# apps/gateway — sign-in with GitHub or ORCID (Better Auth; no email/password).
# Signing in is optional: it is how a researcher creates API keys
# (POST /api/keys) for a quota of their own. Keyless callers, the website
# included, are limited per IP address.
# Public origin of the gateway; auth routes live under <BETTER_AUTH_URL>/api/auth.
# Required in production and must be https (session cookies are then Secure).
# Defaults to http://localhost:3001 in development.
BETTER_AUTH_URL=
# Signs session cookies and OAuth state. Required in production (at least 32
# characters), e.g. `openssl rand -hex 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# GitHub OAuth app (https://github.com/settings/developers). Callback URL:
# <BETTER_AUTH_URL>/api/auth/callback/github. Required in production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ORCID public API client (https://orcid.org/developer-tools). Redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/orcid. Required in production.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# https://orcid.org (production) or https://sandbox.orcid.org (testing).
# Defaults to the sandbox in development and to orcid.org in production.
ORCID_ISSUER=
# Comma-separated proxy addresses/CIDRs whose X-Forwarded-For is trusted
# (right-most entry that is not itself a trusted proxy wins); otherwise the
# socket address is the client IP. Keys the per-IP quota of keyless callers,
# the open-route limit and the auth-route limiter. Default: 127.0.0.1,::1.
# Compose pins its network to QRB_NETWORK_SUBNET and defaults this to
# 127.0.0.1,::1,172.28.0.1 (the host reverse proxy arrives from 172.28.0.1).
TRUSTED_PROXIES=
# apps/gateway — quotas and rate limits (all optional; defaults shown).
# Roll out in log-only mode first: with QRB_LIMITS_MODE=log, a request that
# would get 429 is let through and logged as one JSON line
# {"event":"limit_would_reject","limit":...,"key":...,"status":429}; counters
# still increase. 401 (invalid API key) and 413 (body over 1 MiB) always apply.
QRB_LIMITS_MODE=enforce
# Daily units (reset 00:00 UTC): keyless callers share QRB_LIMIT_ANON_DAILY per
# IP address; a signed-in user and their API keys share QRB_LIMIT_SIGNED_IN_DAILY.
# A resolve costs 1, or QRB_LIMIT_LIVE_REFRESH_WEIGHT when it fetches fresh
# provider data (force_refresh, the default on /select and /instance).
QRB_LIMIT_ANON_DAILY=50
QRB_LIMIT_SIGNED_IN_DAILY=200
QRB_LIMIT_LIVE_REFRESH_WEIGHT=5
# Burst limits (requests per window): per IP address (keyless), per signed-in user, per API key.
QRB_LIMIT_BURST_WINDOW_SECONDS=60
QRB_LIMIT_BURST_ANON=10
QRB_LIMIT_BURST_SIGNED_IN=20
QRB_LIMIT_BURST_API_KEY=20
# Open routes (health, catalog, engines, presets, usage): requests per window per IP.
QRB_LIMIT_OPEN_WINDOW_SECONDS=60
QRB_LIMIT_OPEN_PER_IP=60
# apps/gateway — without DATABASE_URL (development only) the gateway uses
# PGlite, an in-process Postgres. Set a directory to keep its data between
# runs; unset means in memory (accounts are lost on restart).
PGLITE_DATA_DIR=

# apps/api — catalog snapshot read when a request sets live=false. Clients
# cannot choose a path. Unset means catalog_snapshot.json in the API's working
# directory; compose sets the paper's snapshot.
QRB_SNAPSHOT_PATH=

# Historical data (packages/qrb-store, apps/poller) — optional. Unset
# means qrb_store.record_binding()/record_telemetry_sample() are no-ops;
# selection itself works with zero Postgres configured either way.
DATABASE_URL=postgresql+psycopg://qrb:qrb@localhost:5432/qrb
# Password for the `postgres` docker-compose service (the gateway's accounts,
# keys and quota counters). Compose builds the gateway's DATABASE_URL from it,
# so the DATABASE_URL above is only for running things on the host. Use a long
# random value in production, URL-safe characters only (`openssl rand -hex 24`).
POSTGRES_PASSWORD=qrb
# Compose network subnet (pinned so TRUSTED_PROXIES can name its gateway).
# QRB_NETWORK_SUBNET=172.28.0.0/24
# apps/poller: queue length and status of every QPU (cheap; this is how fresh a
# default bind's queues are). Each QPU's Target and calibration is stored per
# calibration, so a change stores that QPU only; a Braket recalibration seen on
# a status tick is fetched at once.
QRB_POLLER_STATUS_SECONDS=120
# IBM's backends whole (status, properties, Targets): IBM updates calibration
# several times a day per backend. Only backends whose calibration changed are
# stored again.
QRB_POLLER_IBM_SECONDS=600
# Everything, both providers (also confirms which QPUs exist).
QRB_POLLER_CATALOG_SECONDS=1800
# How long stored catalogs and queue rows are kept.
QRB_CATALOG_RETENTION_DAYS=7
# apps/api: stored queues older than this are fetched live by the next request
# (a few seconds); if no QPU was confirmed within the second, everything is
# fetched live. Without DATABASE_URL the API fetches live itself, as before.
QRB_CATALOG_MAX_AGE_SECONDS=900
QRB_CALIBRATION_MAX_AGE_SECONDS=7200
